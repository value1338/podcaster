{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "noUnusedLocals": true, "noFallthroughCasesInSwitch": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
