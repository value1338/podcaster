# Podcast-Studio – Server-/Infrastruktur-Variablen.
# KI-Dienste (LLM, Spracherkennung) werden NICHT hier, sondern nach dem Login
# unter Verwaltung → Einstellungen eingetragen.

# Bind-Adresse und Port. Ohne Container 127.0.0.1 lassen (Reverse-Proxy davor).
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8850

# Datenverzeichnis (SQLite-Datenbank, Medien, Admin-Einrichtungsdatei).
# In Docker fest /data (Volume) – hier nur für systemd/Direktstart relevant.
STUDIO_DATA_DIR=/var/lib/podcaster

# Unterpfad, falls die App nicht unter "/" läuft (ohne Schrägstrich am Ende, z. B. /podcast).
# Muss beim UI-Build zu VITE_BASE passen (VITE_BASE=/podcast/).
STUDIO_BASE_PATH=
VITE_BASE=/

# Exakte erlaubte Origins (Pflicht), kommagetrennt, ohne Pfad.
STUDIO_ORIGINS=https://studio.example.com

# Öffentliche Basis-URL inkl. Unterpfad – für Einrichtungs-, Einladungs- und Zuschauer-Links.
STUDIO_PUBLIC_URL=https://studio.example.com

# E-Mail des Admins. Beim ersten Start ohne Admin entsteht ein Einmal-Einrichtungslink
# in <STUDIO_DATA_DIR>/admin-einrichtung.txt (und einmal im Log).
STUDIO_ADMIN_EMAIL=admin@example.com

# Nur für lokale Tests ohne HTTPS (in NODE_ENV=production verboten).
# STUDIO_COOKIE_INSECURE=1

# Optional: Archivziel (Mount). Ohne Angabe ist die Archivierung deaktiviert.
# STUDIO_ARCHIVE_DRIVER=mount
# STUDIO_ARCHIVE_PATH=/mnt/podcaster-archiv
# STUDIO_ARCHIVE_ID=archiv-1
# STUDIO_ARCHIVE_EXPECTED_FILESYSTEM=cifs
